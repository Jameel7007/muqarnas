{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@muqarnas/plan": ["./packages/plan/src/index.ts"],
      "@muqarnas/lift": ["./packages/lift/src/index.ts"],
      "@muqarnas/render": ["./packages/render/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "site/src", "vitest.config.ts"]
}
